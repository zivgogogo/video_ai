# AI 剧本创作工具 — 配置文件
# 复制此文件为 .env 并填入你的配置

# ═══════════════════════════════════════════════════════════════
# 流水线 AI 后端（用于剧本生成流水线，选一个）
# ═══════════════════════════════════════════════════════════════

# 方案 A：Claude API（推荐，中文理解最强）
SCRIPT_TOOL_AI_PROVIDER=claude
SCRIPT_TOOL_AI_MODEL=claude-sonnet-4-6
# SCRIPT_TOOL_ANTHROPIC_API_KEY=sk-ant-你的key

# 方案 B：OpenAI GPT
# SCRIPT_TOOL_AI_PROVIDER=openai
# SCRIPT_TOOL_AI_MODEL=gpt-4o
# SCRIPT_TOOL_OPENAI_API_KEY=sk-你的key

# 方案 C：DeepSeek（推荐性价比，中文优秀）
# SCRIPT_TOOL_AI_PROVIDER=deepseek
# SCRIPT_TOOL_AI_MODEL=deepseek-chat
# SCRIPT_TOOL_DEEPSEEK_API_KEY=sk-你的key

# 方案 D：Gemini（Google，免费额度友好）
# SCRIPT_TOOL_AI_PROVIDER=gemini
# SCRIPT_TOOL_AI_MODEL=gemini-2.5-flash
# SCRIPT_TOOL_GEMINI_API_KEY=你的key

# 方案 E：LM Studio / Ollama（免费本地运行）
# SCRIPT_TOOL_AI_PROVIDER=local
# SCRIPT_TOOL_AI_MODEL=qwen2.5-7b-instruct
# (端口 1234 已预设)

# ═══════════════════════════════════════════════════════════════
# AI 助手聊天配置（项目页面右下角 AI 助手）
# ═══════════════════════════════════════════════════════════════
#
# AI 助手支持 5 种模型，在页面下拉菜单中切换。
# 你需要为你想用的模型配置对应的 API Key：

# Claude：
# SCRIPT_TOOL_ANTHROPIC_API_KEY=sk-ant-你的key

# GPT (OpenAI)：
# SCRIPT_TOOL_OPENAI_API_KEY=sk-你的key
# 可选：自定义 API 地址（如使用中转服务）
# SCRIPT_TOOL_OPENAI_BASE_URL=https://你的代理地址/v1

# DeepSeek：
# SCRIPT_TOOL_DEEPSEEK_API_KEY=sk-你的key
# SCRIPT_TOOL_DEEPSEEK_MODEL=deepseek-chat    # 可选，默认 deepseek-chat

# Gemini (Google)：
# SCRIPT_TOOL_GEMINI_API_KEY=你的key
# SCRIPT_TOOL_GEMINI_MODEL=gemini-2.5-flash   # 可选，默认 gemini-2.5-flash

# 本地模型（LM Studio / Ollama）：
# SCRIPT_TOOL_LOCAL_LLM_URL=http://localhost:1234/v1
# SCRIPT_TOOL_LOCAL_LLM_API_KEY=not-needed

# ═══════════════════════════════════════════════════════════════
# 其他可选配置
# ═══════════════════════════════════════════════════════════════

# 数据库路径（Windows / WSL 用户建议设置）
# SCRIPT_TOOL_DATABASE_URL=sqlite:///C:/Users/你的用户名/script_tool.db

# ══════════════════════════════════════════════════════════
# 影视化生成（角色图 / 三视图 / 分镜 / 视频，走阿里云百炼 DashScope）
# 需在百炼控制台开通对应模型权限后才能出图/出视频
# ══════════════════════════════════════════════════════════
# 百炼 API Key（不填则回退用上面的 OPENAI_API_KEY）
# SCRIPT_TOOL_DASHSCOPE_API_KEY=sk-你的key
# 角色形象图/三视图模型（默认千问图像3.0旗舰版）
# SCRIPT_TOOL_REF_IMAGE_MODEL=qwen-image-3.0-pro
# ── v4 视频模型（分镜与「创作工作台」共用；默认已内置，可不填）──
# 单图/首帧生视频
# SCRIPT_TOOL_HAPPYHORSE_I2V_MODEL=happyhorse-1.1-i2v
# 参考生视频（多参考图保持角色一致性，最多 9 张）
# SCRIPT_TOOL_HAPPYHORSE_R2V_MODEL=happyhorse-1.1-r2v
# 文生/首尾帧/参考（可把上一段末帧接为下一段首帧，串长视频）
# SCRIPT_TOOL_WAN3_VIDEO_MODEL=wan3.0-video
# 分镜/工作台默认视频模型
# SCRIPT_TOOL_VIDEO_MODEL_DEFAULT=happyhorse-1.1-r2v

# ═══════════════════════════════════════════════
# v6 角色配音（CosyVoice 语音合成，走 DashScope，复用上面的 DASHSCOPE_API_KEY）
# 需在百炼控制台开通「语音合成」服务；CosyVoice v1 已下线，用 v2/v3
# 依赖 dashscope SDK（requirements.txt 已加）：pip install "dashscope>=1.26.4"
# ═══════════════════════════════════════════════
# 语音合成模型：cosyvoice-v3-flash（默认、音色最多）/ v3-plus（音质最佳）/ v2
# SCRIPT_TOOL_COSYVOICE_MODEL=cosyvoice-v3-flash
# 默认音色（角色未单独配音色时用）；完整音色见 Prompt 中心「🎙 角色配音」
# SCRIPT_TOOL_COSYVOICE_VOICE=longanyang
# 合成默认参数：音量[0,100] / 语速[0.5,2.0] / 音调[0.5,2.0]
# SCRIPT_TOOL_COSYVOICE_VOLUME=50
# SCRIPT_TOOL_COSYVOICE_RATE=1.0
# SCRIPT_TOOL_COSYVOICE_PITCH=1.0
# 音频格式：mp3（默认）/ wav / pcm
# SCRIPT_TOOL_COSYVOICE_FORMAT=mp3
# WebSocket 端点（用业务空间专属域名时才需填）
# SCRIPT_TOOL_COSYVOICE_WS_URL=wss://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api-ws/v1/inference
# 视频是否默认混入配音（0=关闭，仅烧字幕输出无声视频）
# SCRIPT_TOOL_VOICE_MUX=1
